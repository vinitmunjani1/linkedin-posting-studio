# LinkedIn Developer App credentials
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here

# Must exactly match the redirect URL added in LinkedIn Developer Portal
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

# Space-separated OAuth scopes. w_member_social is required for posting.
LINKEDIN_SCOPES=openid profile email w_member_social

# Server config
PORT=3000
# Use 127.0.0.1 for local-only; use 0.0.0.0 only behind firewall/reverse proxy or with APP_PASSWORD.
HOST=127.0.0.1
SESSION_SECRET=change_me_to_a_long_random_string
# Optional but strongly recommended if exposing the app on a VPS.
APP_PASSWORD=change_me_to_a_private_password

# Safety: keep true until you are ready. When true, /posts/:id/publish validates only and will not call LinkedIn.
DRY_RUN=true

# v1 scheduler
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000
MAX_POSTS_PER_DAY=3
